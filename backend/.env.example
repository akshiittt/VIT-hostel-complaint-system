# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include a database name, e.g. .../vithostel?retryWrites=true
MONGO_URI=
# Long random string used to sign login tokens
JWT_SECRET=
# Comma-separated frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
PORT=5000
# Optional. Comma-separated email domains students may sign up with, e.g. vitstudent.ac.in
# Leave empty to allow any domain.
ALLOWED_EMAIL_DOMAINS=

# Used by `npm run seed` to create/update the warden account.
# SEED_WARDEN_PASSWORD (8+ characters) is required unless MONGO_URI is localhost.
SEED_WARDEN_NAME=
SEED_WARDEN_EMAIL=
SEED_WARDEN_PASSWORD=
